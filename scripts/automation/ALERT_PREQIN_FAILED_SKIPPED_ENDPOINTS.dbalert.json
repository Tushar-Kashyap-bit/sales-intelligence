{
  "custom_summary": "Preqin Alert: @QUERY_RESULT_VALUE endpoints failed/skipped today",
  "evaluation": {
    "source": {
      "name": "total_failed_count",
      "display": "total_failed_count"
    },
    "comparison_operator": "GREATER_THAN_OR_EQUAL",
    "threshold": {
      "value": {
        "double_value": 1.0
      }
    },
    "empty_result_state": "OK",
    "notification": {
      "retrigger_seconds": 1,
      "notify_on_ok": false
    }
  },
  "schedule": {
    "quartz_cron_schedule": "55 0 11 * * ?",
    "timezone_id": "UTC"
  },
  "query_lines": [
    "SELECT",
    "  endpoint_url,",
    "  status,",
    "  MAX(run_id) AS run_id,",
    "  MAX(created_timestamp) AS created_timestamp,",
    "  COUNT(*) OVER() AS total_failed_count",
    "FROM",
    "  dev.bronze_preqin.preqin_api_audit_log",
    "WHERE",
    "  (",
    "    status LIKE 'FAILED%'",
    "    OR status LIKE 'SKIPPED%'",
    "  )",
    "  AND CAST(created_timestamp AS DATE) = CURRENT_DATE()",
    "GROUP BY",
    "  endpoint_url, status",
    "ORDER BY",
    "  status, endpoint_url"
  ],
  "custom_description_lines": [
    "**Total endpoints failed/skipped today = @QUERY_RESULT_VALUE**",
    "",
    "@QUERY_RESULT_TABLE"
  ]
}
